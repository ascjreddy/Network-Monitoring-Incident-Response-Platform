          "rawQuery": true,
          "rawSql": "SELECT\n  date_trunc('minute', timestamp) as time,\n  device_name,\n  COUNT(*) as events\nFROM syslog_events\nWHERE $__timeFilter(timestamp)\nGROUP BY 1, 2\nORDER BY 1",
